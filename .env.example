# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cyberdefense
SQLITE_URL=sqlite:///./cyberdefense.db

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ML Models
MODEL_PATH=./data/models/
BATCH_SIZE=32
WINDOW_SIZE=100

# Alerts
ALERT_THRESHOLD=0.8
MAX_ALERTS_PER_MINUTE=10

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000/ws